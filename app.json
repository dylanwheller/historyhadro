{
  "expo": {
    "name": "HistoryHadro",
    "slug": "historyhadro",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-dino.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1300"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartypants.historyhadro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#1a1300"
      },
      "package": "com.smartypants.historyhadro",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        { "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID" }
      ],
      "expo-audio"
    ],
    "scheme": "historyhadro",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "GOOGLE_WEB_CLIENT_ID": "484276241658-c4guf8kn8d4ed852i62ug1mfi8bt1dj7.apps.googleusercontent.com",
      "GOOGLE_IOS_CLIENT_ID": "484276241658-c4guf8kn8d4ed852i62ug1mfi8bt1dj7.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID": "484276241658-c4guf8kn8d4ed852i62ug1mfi8bt1dj7.apps.googleusercontent.com",
      "REVENUECAT_ANDROID_KEY": "goog_ygFcBfuJfEjbJVLZvyVzCLitOZs",
      "REVENUECAT_IOS_KEY": "REPLACE_WITH_HISTORYHADRO_REVENUECAT_IOS_KEY",
      "router": {},
      "eas": {
        "projectId": "c32d0bc3-e433-4448-916c-c0be9fc3df9f"
      }
    }
  }
}
